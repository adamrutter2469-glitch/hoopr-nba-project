# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real secrets. See README.md for how each is loaded.

# Odds API key (e.g. for pulling betting lines to compare against
# model predictions). Not yet wired into any pipeline stage.
ODDS_API_KEY=your-key-here

# Cloudflare R2 (see R/sync_r2.R) - mirrors data_raw/ and
# data_processed/ to your R2 bucket after every pipeline run.
# Get these from the Cloudflare dashboard: R2 -> Manage R2 API Tokens.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
