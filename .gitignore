.Rproj.user/
.Rhistory
.RData
.Ruserdata
.claude/
logs/

# Pipeline outputs - regenerated by run_pipeline.bat every run, so they
# don't belong in git history (they'd bloat the repo on every commit).
# Run scripts/00_install_packages.R then run_pipeline.bat to (re)build
# them locally. Reference data that's static and small (the travel-time
# CSV) IS tracked, since a fresh clone needs it to run at all.
data_raw/*
!data_raw/external
!data_raw/external/**
data_processed/*
state/*.json

# Trained model artifacts - regenerated by models/train_rebounds_model.R,
# not versioned (same reasoning as the pipeline data above).
models/*.rds
models/*.model

# Python (python/) - venv and bytecode cache, not versioned.
python/.venv/
python/venv/
__pycache__/
*.pyc

# PyCharm's own project state - machine-specific, not versioned.
.idea/

# Never commit secrets, regardless of where they land in the tree.
*api_key*
*apikey*
*secret*
*.pem
*.key
.env
.env.*
!.env.example

